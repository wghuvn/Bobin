+    private StructureDebrisRenderer(){}
+    public static void register() {
+        ClientPlayConnectionEvents.DISCONNECT.register((handler,client)->clear());
+        ClientPlayNetworking.registerGlobalReceiver(DebrisNetworking.CHANNEL,(client,handler,buf,sender)->{
+            if(buf.readableBytes()>DebrisNetworking.MAX_PACKET_BYTES)return;
+            try {
+                int version=buf.readVarInt();if(version!=DebrisNetworking.PROTOCOL)return;
+                String dim=buf.readString(128);UUID session=buf.readUuid();long seq=buf.readLong();int type=buf.readUnsignedByte();
+                DebrisFragment fragment=type==1?DebrisPersistentState.decode(Objects.requireNonNull(buf.readNbt())):null;
+                UUID removed=type==2?buf.readUuid():null;
+                if(type<0||type>2||buf.isReadable()||fragment!=null&&!fragment.dimension.equals(dim))return;
+                client.execute(()->{try{apply(dim,session,seq,type,fragment,removed);}catch(IllegalArgumentException invalid){/* unresolved registry state: no invented substitute */}});
+            }catch(RuntimeException invalid){/* bounded malformed cosmetic payload cannot mutate world state */}
+        });
+        WorldRenderEvents.AFTER_TRANSLUCENT.register(context->{
+            var client=MinecraftClient.getInstance();var world=client.world;
+            if(world==null||context.matrixStack()==null||context.consumers()==null||!world.getRegistryKey().getValue().toString().equals(WINDOW.dimension()))return;
+            var camera=context.camera().getPos();var matrices=context.matrixStack();var consumers=context.consumers();
+            var ordered=new ArrayList<>(MESHES.values());ordered.sort(Comparator.comparingDouble(m->camera.squaredDistanceTo(m.now.position.x(),m.now.position.y(),m.now.position.z())));
+            int models=0,fragments=0;
+            for(var mesh:ordered){var f=mesh.now;
+                if(fragments>=maxVisibleFragments||models+mesh.materials.size()>maxBlockModelsPerFrame)break;
+                if(camera.squaredDistanceTo(f.position.x(),f.position.y(),f.position.z())>192*192)continue;
+                B bounds=f.bounds();if(bounds==null)continue;boolean loaded=true;
+                for(int x=(int)Math.floor(bounds.x0())>>4;x<=(int)Math.floor(bounds.x1())>>4;x++)for(int z=(int)Math.floor(bounds.z0())>>4;z<=(int)Math.floor(bounds.z1())>>4;z++)if(!world.isChunkLoaded(x,z))loaded=false;
+                if(!loaded)continue;
+                double blend=f.phase==Phase.PAUSED_UNLOADED?1:Math.min(1,Math.max(0,(world.getTime()-mesh.received+context.tickDelta())/4.0));
+                V p=mesh.previous.mul(1-blend).add(f.position.mul(blend));
+                var q0=new Quaternionf((float)mesh.previousRotation.x(),(float)mesh.previousRotation.y(),(float)mesh.previousRotation.z(),(float)mesh.previousRotation.w());
+                var q1=new Quaternionf((float)f.rotation.x(),(float)f.rotation.y(),(float)f.rotation.z(),(float)f.rotation.w());q0.slerp(q1,(float)blend);
+                int light=ImpactDebrisClient.sampleFragmentLight(world,p.x(),p.y(),p.z(),-1);
+                matrices.push();matrices.translate(p.x()-camera.x,p.y()-camera.y,p.z()-camera.z);matrices.multiply(q0);
+                for(int i=0;i<f.cells.size();i++){var c=f.cells.get(i);if(c.commit!=Commit.REMOVED)continue;
+                    matrices.push();matrices.translate(c.local.x(),c.local.y(),c.local.z());
+                    client.getBlockRenderManager().renderBlockAsEntity(mesh.materials.get(i),matrices,consumers,light,OverlayTexture.DEFAULT_UV);matrices.pop();models++;}
+                matrices.pop();fragments++;
+            }
+        });
+    }
+    private static void apply(String dim,UUID session,long seq,int type,DebrisFragment f,UUID removed) {
+        if(type==0){if(WINDOW.reset(dim,session,seq))MESHES.clear();return;}
+        if(!WINDOW.accept(dim,session,seq,type==2?removed:f.id,type==2?0:f.revision,type==2))return;
+        if(type==2){MESHES.remove(removed);return;}
+        Mesh old=MESHES.get(f.id);if(old!=null&&f.revision<old.now.revision)return;
+        if(old==null&&MESHES.size()>=DebrisPersistentState.MAX_RECORDS)return;
+        var states=new ArrayList<BlockState>();for(var c:f.cells)states.add(RefineryTransitions.decode(c.state));
+        long now=MinecraftClient.getInstance().world==null?0:MinecraftClient.getInstance().world.getTime();
+        boolean same=old!=null&&f.geometryRevision==old.now.geometryRevision;
+        MESHES.put(f.id,new Mesh(f,same?old.now.position:f.position,same?old.now.rotation:f.rotation,now,List.copyOf(states)));
+    }
+    public static void clear(){MESHES.clear();WINDOW.clear();}

+                    if(next!=null&&Math.floorDiv(next.x,4)==Math.floorDiv(seed.x,4)&&Math.floorDiv(next.y,2)==Math.floorDiv(seed.y,2)
+                            &&Math.floorDiv(next.z,4)==Math.floorDiv(seed.z,4)&&scheduled.add(next.packed()))queue.add(next);
+                }

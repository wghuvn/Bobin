{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bobincraft:armament:common:1",
  "title": "Bobin Craft armament common v1",
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9_-]+(?:[.][a-z0-9_-]+)*:[a-z0-9_-]+(?:[./][a-z0-9_-]+)*(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
    },
    "transform": {
      "type": "object",
      "properties": {
        "translation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1024,
            "maximum": 1024
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1024
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Quaternion normalization and cross-document relationships are checked by Java semantic validators."
}

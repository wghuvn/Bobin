{
  "schemaVersion": 1,
  "id": "bobin_craft",
  "version": "${version}",
  "name": "Bobin Craft",
  "description": "Bobin Craft world generation, combat zone and FPV drone systems.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bobincraft.BobinCraft"
    ],
    "client": [
      "com.bobincraft.BobinCraftClient",
      "com.bobincraft.armament.client.ArmamentGlbClient"
    ],
    "fabric-gametest": [
      "com.bobincraft.destruction.DestructionGameTestSuite"
    ]
  },
  "mixins": [
    "bobin_craft.mixins.json",
    {"config": "bobin_craft.armament.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
